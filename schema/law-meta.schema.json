{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-nation.dev/schema/law-meta.schema.json",
  "title": "Law metadata block (law-meta)",
  "description": "The machine-readable mirror of a law's prose. Specified in GOVERNANCE.md section 5.1; enforced by tools/nation.mjs validate.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "version", "status", "adopted", "pillars", "summary", "articles", "metrics", "sunset", "dissent", "history"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^law\\.[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Repository-unique law id; must match the filename (see GOVERNANCE.md 5.2 check 3)."
    },
    "title": {
      "type": "string",
      "minLength": 3,
      "description": "Byte-identical to the text after '# ' on the first heading line of the file."
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "status": {
      "enum": ["draft", "proposed", "trial", "ratified", "amended", "sunset", "repealed"]
    },
    "adopted": {
      "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }]
    },
    "pillars": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["direction", "engine", "commons", "floor", "governance"] }
    },
    "summary": {
      "type": "string",
      "minLength": 40,
      "maxLength": 1200
    },
    "articles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "evidence", "falsifier"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z]{1,4}\\d+$",
            "description": "Unique within the law; must appear in the body as a level-3 heading '### <id> — <title>'."
          },
          "title": { "type": "string", "minLength": 3 },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^(vote|data|study|audit|model|pending):.+$",
              "description": "Evidence pointer; see GOVERNANCE.md section 4."
            }
          },
          "falsifier": {
            "type": "string",
            "minLength": 20,
            "description": "The observable outcome that would prove the article wrong."
          }
        }
      }
    },
    "parameters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "value", "unit", "evidence"],
        "properties": {
          "name": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$" },
          "value": { "type": ["number", "string", "boolean"] },
          "unit": { "type": "string", "minLength": 1 },
          "evidence": {
            "type": "string",
            "pattern": "^(vote|data|study|audit|model|pending):.+$"
          }
        }
      }
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 5 }
    },
    "sunset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["review_every_years", "expires"],
      "properties": {
        "review_every_years": { "type": "integer", "minimum": 1, "maximum": 50 },
        "expires": {
          "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }]
        }
      }
    },
    "dissent": {
      "type": "array",
      "items": { "type": "string", "minLength": 10 },
      "description": "Recorded objections. May be empty only if there is genuinely none."
    },
    "open_questions": {
      "type": "array",
      "items": { "type": "string", "minLength": 5 }
    },
    "history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["version", "date", "change"],
        "properties": {
          "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
          "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "change": { "type": "string", "minLength": 3 }
        }
      }
    }
  }
}
